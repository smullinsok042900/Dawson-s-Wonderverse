{
  "rules": {
    ".read": false,
    ".write": false,
    "dw3": {
      "rooms": {
        "$code": {
          ".validate": "$code.length === 4",
          "players": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['x', 'y', 'z', 't']) && newData.child('x').isNumber() && newData.child('x').val() > -2000 && newData.child('x').val() < 9000 && newData.child('y').isNumber() && newData.child('y').val() > -100 && newData.child('y').val() < 300 && newData.child('z').isNumber() && newData.child('z').val() > -100 && newData.child('z').val() < 100",
              "f": {
                ".validate": "newData.val() === 1 || newData.val() === -1"
              },
              "g": {
                ".validate": "newData.isBoolean()"
              },
              "r": {
                ".validate": "newData.isBoolean()"
              },
              "h": {
                ".validate": "newData.isBoolean()"
              },
              "l": {
                ".validate": "newData.isString() && newData.val().length < 12"
              },
              "c": {
                ".validate": "newData.isString() && newData.val().length < 12"
              },
              "k": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 4"
              },
              "ps": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 60)"
              },
              "x": {
                ".validate": "newData.isNumber()"
              },
              "y": {
                ".validate": "newData.isNumber()"
              },
              "z": {
                ".validate": "newData.isNumber()"
              },
              "t": {
                ".validate": true
              },
              "a": {
                ".validate": "newData.isString() && newData.val().length < 60"
              },
              "dk": {
                ".validate": "newData.isString() && newData.val().length < 60"
              },
              "b": {
                ".validate": "newData.val() === 1"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "objects": {
            ".read": "auth != null",
            "$key": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['t', 'by', 'at']) && newData.child('by').val() === auth.uid && ((newData.child('t').val() === 'b' && newData.child('i').isNumber() && newData.child('i').val() >= 0 && newData.child('i').val() < 200 && newData.child('v').isNumber() && newData.child('v').val() >= -1 && newData.child('v').val() < 11) || (newData.child('t').val() === 's' && newData.child('segs').isString() === false && newData.child('segs').hasChildren() && newData.child('segs').child('0').hasChildren(['a', 'b', 'c', 'w']) && newData.child('segs').child('0').child('c').isString() && newData.child('segs').child('0').child('c').val().length <= 32 && newData.child('segs').child('0').child('w').isNumber()) || (newData.child('t').val() === 'x'))",
              "t": {
                ".validate": "newData.isString() && newData.val().length <= 2"
              },
              "by": {
                ".validate": "newData.isString() && newData.val().length < 60"
              },
              "at": {
                ".validate": true
              },
              "i": {
                ".validate": "newData.isNumber()"
              },
              "v": {
                ".validate": "newData.isNumber()"
              },
              "segs": {
                ".validate": "newData.hasChildren()",
                "$seg": {
                  ".validate": "$seg.matches(/^([0-9]|1[0-9]|2[0-3])$/) && newData.hasChildren(['a', 'b', 'c', 'w']) && newData.child('c').isString() && newData.child('c').val().length <= 32 && newData.child('w').isNumber() && newData.child('a').isString() === false && newData.child('b').isString() === false"
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "events": {
            ".read": "auth != null",
            "$key": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['t', 'by', 'at']) && (newData.child('t').val() === 'wave' || newData.child('t').val() === 'bubble') && newData.child('by').val() === auth.uid",
              "t": {
                ".validate": "newData.val() === 'wave' || newData.val() === 'bubble'"
              },
              "to": {
                ".validate": "newData.isString() && newData.val().length < 60"
              },
              "by": {
                ".validate": "newData.isString() && newData.val().length < 60"
              },
              "at": {
                ".validate": true
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "voice": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === true && root.child('dw3/rooms/' + $code + '/players/' + $uid).exists()"
            }
          },
          "sig": {
            "$to": {
              ".read": "auth != null && auth.uid === $to",
              ".write": "auth != null && auth.uid === $to && !newData.exists()",
              "$key": {
                ".write": "auth != null && ((auth.uid === $to && !newData.exists()) || (newData.exists() && newData.child('f').val() === auth.uid && root.child('dw3/rooms/' + $code + '/players/' + auth.uid).exists() && root.child('dw3/rooms/' + $code + '/players/' + $to).exists()))",
                ".validate": "newData.hasChildren(['f', 'd', 'at'])",
                "f": {
                  ".validate": "newData.isString() && newData.val().length < 60"
                },
                "d": {
                  ".validate": "newData.isString() && newData.val().length < 20000"
                },
                "at": {
                  ".validate": true
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "live": {
            ".read": "auth != null",
            "$key": {
              ".write": "auth != null && ($key.beginsWith('s_') ? $key === 's_' + auth.uid : (!data.exists() || !newData.exists() || data.child('host').val() === auth.uid || newData.child('host').val() === auth.uid))",
              ".validate": "$key.length < 64 && (($key.beginsWith('s_') && newData.hasChildren(['v', 'seat', 'at'])) || ($key.beginsWith('f_') && newData.hasChildren(['host', 'st', 'at']) && newData.child('host').val() === auth.uid))",
              "v": {
                ".validate": "newData.isString() && newData.val().length < 40"
              },
              "seat": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 6"
              },
              "rd": {
                ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
              },
              "host": {
                ".validate": "newData.isString() && newData.val().length < 60"
              },
              "st": {
                ".validate": "newData.val() === 'board' || newData.val() === 'go'"
              },
              "d": {
                ".validate": "newData.isString() && newData.val().length < 12"
              },
              "n": {
                ".validate": "newData.isNumber()"
              },
              "t0": {
                ".validate": "newData.isNumber()"
              },
              "at": {
                ".validate": true
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
